{
  "name": "nx-pg",
  "version": "0.1.9",
  "description": "本机工具：CLI 与 Web 面板同源",
  "type": "module",
  "bin": {
    "nx-pg": "bin/pg.mjs"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "assets",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "node scripts/dev.mjs",
    "dev:vite": "vite --host 127.0.0.1",
    "dev:serve": "node bin/pg.mjs serve --no-open",
    "start": "pnpm run build && node bin/pg.mjs serve",
    "link:local": "node scripts/link-local.mjs",
    "unlink:local": "node scripts/link-local.mjs --unlink",
    "lint": "eslint .",
    "test": "pnpm run lint && pnpm run build && pnpm run test:smoke && pnpm run test:unit",
    "test:smoke": "node tests/smoke.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "logo": "node tools/logo-gen/cli.mjs"
  },
  "packageManager": "pnpm@10.33.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZHLX2005/nx-pg.git"
  },
  "homepage": "https://github.com/ZHLX2005/nx-pg#readme",
  "bugs": {
    "url": "https://github.com/ZHLX2005/nx-pg/issues"
  },
  "license": "MIT",
